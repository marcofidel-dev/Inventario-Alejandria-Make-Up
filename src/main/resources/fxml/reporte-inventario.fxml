<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.marcofidel_dev.inventario.ui.controller.ReporteInventarioController"
      spacing="14" style="-fx-padding: 20; -fx-background-color: #FCE4EC;">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label text="Reporte de Inventario"
               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #880E4F;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="📄 PDF" onAction="#exportarPDF"
                style="-fx-background-color: #D32F2F; -fx-text-fill: white; -fx-background-radius: 8;
                       -fx-padding: 8 14; -fx-font-weight: 600; -fx-cursor: hand;"/>
        <Button text="📊 Excel" onAction="#exportarExcel"
                style="-fx-background-color: #388E3C; -fx-text-fill: white; -fx-background-radius: 8;
                       -fx-padding: 8 14; -fx-font-weight: 600; -fx-cursor: hand;"/>
    </HBox>

    <!-- KPIs valoración -->
    <HBox spacing="12"
          style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 16;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 6, 0, 0, 2);">
        <VBox spacing="4" HBox.hgrow="ALWAYS" alignment="CENTER">
            <Label text="Valor a costo" style="-fx-font-size: 11px; -fx-text-fill: #757575;"/>
            <Label fx:id="lblValorCosto" text="" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        </VBox>
        <Separator orientation="VERTICAL"/>
        <VBox spacing="4" HBox.hgrow="ALWAYS" alignment="CENTER">
            <Label text="Valor a precio venta" style="-fx-font-size: 11px; -fx-text-fill: #757575;"/>
            <Label fx:id="lblValorVenta" text="" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        </VBox>
        <Separator orientation="VERTICAL"/>
        <VBox spacing="4" HBox.hgrow="ALWAYS" alignment="CENTER">
            <Label text="Utilidad potencial" style="-fx-font-size: 11px; -fx-text-fill: #757575;"/>
            <Label fx:id="lblUtilPot" text="" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #4CAF50;"/>
        </VBox>
        <Separator orientation="VERTICAL"/>
        <VBox spacing="4" HBox.hgrow="ALWAYS" alignment="CENTER">
            <Label text="Margen promedio" style="-fx-font-size: 11px; -fx-text-fill: #757575;"/>
            <Label fx:id="lblMargenProm" text="" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #9C27B0;"/>
        </VBox>
        <Separator orientation="VERTICAL"/>
        <VBox spacing="4" alignment="CENTER">
            <Label text="Productos / Unidades" style="-fx-font-size: 11px; -fx-text-fill: #757575;"/>
            <Label fx:id="lblProdUnid" text="" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
        </VBox>
    </HBox>

    <!-- Filtro período ABC -->
    <HBox spacing="10" alignment="CENTER_LEFT"
          style="-fx-background-color: white; -fx-background-radius: 8;
                 -fx-padding: 10 14; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 4, 0, 0, 1);">
        <Label text="Período ABC:" style="-fx-font-size: 12px; -fx-font-weight: 600;"/>
        <DatePicker fx:id="dpDesde" prefWidth="140"/>
        <Label text="al" style="-fx-font-size: 12px;"/>
        <DatePicker fx:id="dpHasta" prefWidth="140"/>
        <Button text="Aplicar" onAction="#aplicarFiltroABC"
                style="-fx-background-color: #880E4F; -fx-text-fill: white;
                       -fx-background-radius: 6; -fx-padding: 6 14; -fx-cursor: hand;"/>
    </HBox>

    <!-- Tabs -->
    <TabPane fx:id="tabPane" VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE">

        <!-- Valoración / Inventario por valor -->
        <Tab text="Inventario por Valor">
            <TableView fx:id="tblInventario" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colInvNombre"    text="Producto"     prefWidth="200"/>
                    <TableColumn fx:id="colInvCodigo"    text="Código"       prefWidth="90"/>
                    <TableColumn fx:id="colInvStock"     text="Stock"        prefWidth="65"/>
                    <TableColumn fx:id="colInvCosto"     text="Costo"        prefWidth="100"/>
                    <TableColumn fx:id="colInvPrecio"    text="Precio"       prefWidth="100"/>
                    <TableColumn fx:id="colInvValorC"    text="Valor Costo"  prefWidth="120"/>
                    <TableColumn fx:id="colInvValorV"    text="Valor Venta"  prefWidth="120"/>
                </columns>
            </TableView>
        </Tab>

        <!-- Stock crítico -->
        <Tab text="Stock Crítico">
            <VBox spacing="8" style="-fx-padding: 12;">
                <Label fx:id="lblStockCriticoCount" text=""
                       style="-fx-font-size: 13px; -fx-text-fill: #D32F2F; -fx-font-weight: 600;"/>
                <TableView fx:id="tblStockCritico" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colSCNombre"   text="Producto"   prefWidth="220"/>
                        <TableColumn fx:id="colSCCodigo"   text="Código"     prefWidth="90"/>
                        <TableColumn fx:id="colSCStock"    text="Stock"      prefWidth="80"/>
                        <TableColumn fx:id="colSCMinimo"   text="Mínimo"     prefWidth="80"/>
                        <TableColumn fx:id="colSCDif"      text="Diferencia" prefWidth="90"/>
                    </columns>
                </TableView>
            </VBox>
        </Tab>

        <!-- Sin rotación -->
        <Tab text="Sin Rotación (30d+)">
            <VBox spacing="8" style="-fx-padding: 12;">
                <Label fx:id="lblSinRotCount" text=""
                       style="-fx-font-size: 13px; -fx-text-fill: #F57C00; -fx-font-weight: 600;"/>
                <TableView fx:id="tblSinRotacion" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colSRNombre"   text="Producto"      prefWidth="220"/>
                        <TableColumn fx:id="colSRStock"    text="Stock"         prefWidth="80"/>
                        <TableColumn fx:id="colSRUltVenta" text="Última Venta"  prefWidth="130"/>
                    </columns>
                </TableView>
            </VBox>
        </Tab>

        <!-- Análisis ABC -->
        <Tab text="Análisis ABC">
            <ScrollPane fitToWidth="true">
                <VBox spacing="14" style="-fx-padding: 14;">
                    <VBox spacing="6">
                        <Label text="🟢 Categoría A — 80% de ingresos"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #388E3C;"/>
                        <TableView fx:id="tblABC_A" prefHeight="160">
                            <columns>
                                <TableColumn fx:id="colAA_Nombre"  text="Producto"   prefWidth="200"/>
                                <TableColumn fx:id="colAA_Unid"    text="Unidades"   prefWidth="80"/>
                                <TableColumn fx:id="colAA_Ingreso" text="Ingreso"    prefWidth="110"/>
                                <TableColumn fx:id="colAA_Pct"     text="Acum. %"   prefWidth="90"/>
                            </columns>
                        </TableView>
                    </VBox>
                    <VBox spacing="6">
                        <Label text="🟡 Categoría B — 15% de ingresos"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #F57C00;"/>
                        <TableView fx:id="tblABC_B" prefHeight="160">
                            <columns>
                                <TableColumn fx:id="colAB_Nombre"  text="Producto"   prefWidth="200"/>
                                <TableColumn fx:id="colAB_Unid"    text="Unidades"   prefWidth="80"/>
                                <TableColumn fx:id="colAB_Ingreso" text="Ingreso"    prefWidth="110"/>
                                <TableColumn fx:id="colAB_Pct"     text="Acum. %"   prefWidth="90"/>
                            </columns>
                        </TableView>
                    </VBox>
                    <VBox spacing="6">
                        <Label text="🔴 Categoría C — 5% de ingresos"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #D32F2F;"/>
                        <TableView fx:id="tblABC_C" prefHeight="160">
                            <columns>
                                <TableColumn fx:id="colAC_Nombre"  text="Producto"   prefWidth="200"/>
                                <TableColumn fx:id="colAC_Unid"    text="Unidades"   prefWidth="80"/>
                                <TableColumn fx:id="colAC_Ingreso" text="Ingreso"    prefWidth="110"/>
                                <TableColumn fx:id="colAC_Pct"     text="Acum. %"   prefWidth="90"/>
                            </columns>
                        </TableView>
                    </VBox>
                </VBox>
            </ScrollPane>
        </Tab>

        <!-- Márgenes -->
        <Tab text="Márgenes">
            <TableView fx:id="tblMargenes" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colMgNombre"  text="Producto"   prefWidth="220"/>
                    <TableColumn fx:id="colMgCodigo"  text="Código"     prefWidth="90"/>
                    <TableColumn fx:id="colMgCosto"   text="Costo"      prefWidth="100"/>
                    <TableColumn fx:id="colMgPrecio"  text="Precio"     prefWidth="100"/>
                    <TableColumn fx:id="colMgPesos"   text="Margen $"   prefWidth="110"/>
                    <TableColumn fx:id="colMgPct"     text="Margen %"   prefWidth="90"/>
                </columns>
            </TableView>
        </Tab>

    </TabPane>
</VBox>
