<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.marcofidel_dev.inventario.ui.controller.ComprasController"
      spacing="15" style="-fx-padding: 20; -fx-background-color: #FCE4EC;">

    <Label text="Gestión de Compras" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #880E4F;"/>

    <!-- Filtros -->
    <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);">
        <Label text="Desde:" style="-fx-font-weight: 600; -fx-text-fill: #4A148C;"/>
        <DatePicker fx:id="dpFechaInicio" prefWidth="150" style="-fx-background-radius: 8;"/>

        <Label text="Hasta:" style="-fx-font-weight: 600; -fx-text-fill: #4A148C;"/>
        <DatePicker fx:id="dpFechaFin" prefWidth="150" style="-fx-background-radius: 8;"/>

        <Button text="🔍 Filtrar" onAction="#cargarCompras"
                style="-fx-background-color: #E91E63; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 16; -fx-font-weight: 600; -fx-cursor: hand;"/>

        <Separator orientation="VERTICAL" style="-fx-padding: 0 10;"/>

        <Button text="➕ Nueva" onAction="#nuevaCompra"
                style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 16; -fx-font-weight: 600; -fx-cursor: hand;"/>
        <Button text="✏️ Editar" onAction="#editarCompra"
                style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 16; -fx-font-weight: 600; -fx-cursor: hand;"/>
        <Button text="🗑️ Eliminar" onAction="#eliminarCompra"
                style="-fx-background-color: #F44336; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 16; -fx-font-weight: 600; -fx-cursor: hand;"/>
    </HBox>

    <!-- Tabla de compras -->
    <VBox spacing="10" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);-fx-min-height: 400;">
        <Label text="Historial de Compras" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #880E4F;"/>
        <TableView fx:id="tblCompras" VBox.vgrow="ALWAYS" style="-fx-background-radius: 8; -fx-min-height: 350;">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                <TableColumn fx:id="colProveedor" text="Proveedor" prefWidth="250"/>
                <TableColumn fx:id="colFecha" text="Fecha" prefWidth="120"/>
                <TableColumn fx:id="colTotal" text="Total Costo" prefWidth="120"/>
            </columns>
        </TableView>
    </VBox>

    <Label text="Nota: Al guardar una compra, el stock de los productos se incrementa automáticamente"
           style="-fx-font-style: italic; -fx-text-fill: #4A148C; -fx-font-weight: 600; -fx-background-color: #F3E5F5; -fx-padding: 10; -fx-background-radius: 8;"/>

</VBox>

