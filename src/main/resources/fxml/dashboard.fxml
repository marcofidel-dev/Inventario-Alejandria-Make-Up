<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.effect.DropShadow?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.marcofidel_dev.inventario.ui.controller.DashboardController"
      spacing="20" style="-fx-padding: 20; -fx-background-color: #FCE4EC;">

    <Label text="Panel de Control de Inventarios" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #880E4F;"/>

    <!-- Contadores con efectos de sombra -->
    <HBox spacing="20" alignment="CENTER_LEFT">
        <VBox spacing="5" style="-fx-background-color: linear-gradient(to bottom, #E91E63, #C2185B); -fx-padding: 25; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 10, 0, 0, 3);">
            <Label text="Total Productos" style="-fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: 600;"/>
            <Label fx:id="lblTotalProductos" text="0" style="-fx-text-fill: white; -fx-font-size: 32px; -fx-font-weight: bold;"/>
        </VBox>

        <VBox spacing="5" style="-fx-background-color: linear-gradient(to bottom, #F57C00, #E65100); -fx-padding: 25; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 10, 0, 0, 3);">
            <Label text="Stock Bajo" style="-fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: 600;"/>
            <Label fx:id="lblProductosStockBajo" text="0" style="-fx-text-fill: white; -fx-font-size: 32px; -fx-font-weight: bold;"/>
        </VBox>
    </HBox>

    <!-- Productos con stock bajo -->
    <VBox spacing="10" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="Productos con Stock Bajo" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #880E4F;"/>
            <Button text="🔄 Actualizar" onAction="#cargarDatos"
                    style="-fx-background-color: #E91E63; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 16; -fx-font-weight: 600; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 5, 0, 0, 2);"/>
        </HBox>

        <TableView fx:id="tblStockBajo" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 5;">
            <columns>
                <TableColumn fx:id="colProductoNombre" text="Producto" prefWidth="200"/>
                <TableColumn fx:id="colProductoTipo" text="Tipo" prefWidth="100"/>
                <TableColumn fx:id="colProductoStock" text="Stock Actual" prefWidth="100"/>
                <TableColumn fx:id="colProductoStockMin" text="Stock Mínimo" prefWidth="100"/>
            </columns>
        </TableView>
    </VBox>

</VBox>

