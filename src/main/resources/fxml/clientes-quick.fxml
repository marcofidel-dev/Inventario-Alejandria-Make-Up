<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.marcofidel_dev.inventario.ui.controller.ClienteQuickController"
      spacing="16" maxWidth="320"
      style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 28;
             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, 3);">

    <Label text="Nuevo Cliente Rápido"
           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #880E4F;"/>

    <Separator/>

    <VBox spacing="6">
        <Label text="Nombre *" style="-fx-font-weight: 600; -fx-text-fill: #4A148C;"/>
        <TextField fx:id="txtNombre" promptText="Nombre del cliente"
                   style="-fx-background-radius: 8; -fx-padding: 9; -fx-border-color: #E0E0E0;
                          -fx-border-radius: 8; -fx-font-size: 13px;"/>
    </VBox>

    <VBox spacing="6">
        <Label text="Teléfono" style="-fx-font-weight: 600; -fx-text-fill: #4A148C;"/>
        <TextField fx:id="txtTelefono" promptText="Número de contacto"
                   style="-fx-background-radius: 8; -fx-padding: 9; -fx-border-color: #E0E0E0;
                          -fx-border-radius: 8; -fx-font-size: 13px;"/>
    </VBox>

    <Label fx:id="lblError" text="" wrapText="true"
           style="-fx-text-fill: #D32F2F; -fx-font-size: 12px;" maxWidth="280"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancelar" onAction="#cancelar"
                style="-fx-background-color: #EEEEEE; -fx-text-fill: #555; -fx-background-radius: 8;
                       -fx-padding: 9 18; -fx-font-weight: 600; -fx-cursor: hand;"/>
        <Button fx:id="btnCrear" text="Crear Cliente" onAction="#crear"
                style="-fx-background-color: #E91E63; -fx-text-fill: white; -fx-background-radius: 8;
                       -fx-padding: 9 18; -fx-font-weight: 700; -fx-cursor: hand;
                       -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 5, 0, 0, 2);"/>
    </HBox>
</VBox>
