<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:id="posRoot"
            fx:controller="com.marcofidel_dev.inventario.ui.controller.PosController"
            style="-fx-background-color: #FCE4EC;">

    <fx:define>
        <ToggleGroup fx:id="tgMetodoPago"/>
    </fx:define>

    <!-- ── Header ─────────────────────────────────────────────────────── -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16"
              style="-fx-background-color: linear-gradient(to right, #C2185B, #880E4F); -fx-padding: 12 20;">
            <Label text="POS — Nueva Venta"
                   style="-fx-text-fill: white; -fx-font-size: 19px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblSesionInfo" text="Sesión activa"
                   style="-fx-text-fill: rgba(255,255,255,0.85); -fx-font-size: 12px;"/>
            <Label text="F2=Buscar  F4=Cobrar  Esc=Limpiar"
                   style="-fx-text-fill: rgba(255,255,255,0.55); -fx-font-size: 11px;"/>
        </HBox>
    </top>

    <!-- ── Main: SplitPane 60/40 ──────────────────────────────────────── -->
    <center>
        <SplitPane fx:id="splitPane" dividerPositions="0.60">
            <padding>
                <Insets top="0"/>
            </padding>

            <!-- ===== LEFT PANEL: Search + Results (60%) ===== -->
            <VBox spacing="8"
                  style="-fx-background-color: white; -fx-padding: 14;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 4, 0, 0, 1);">

                <!-- Search bar -->
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <TextField fx:id="txtBuscar"
                               promptText="Buscar producto — nombre, marca, código (F2)..."
                               HBox.hgrow="ALWAYS"
                               onKeyReleased="#onBuscarKeyReleased"
                               style="-fx-background-radius: 8; -fx-padding: 10; -fx-font-size: 14px;
                                      -fx-border-color: #E91E63; -fx-border-radius: 8; -fx-border-width: 2;"/>
                    <Button text="✕" onAction="#limpiarBusqueda"
                            style="-fx-background-color: #EEEEEE; -fx-background-radius: 6; -fx-padding: 10 12; -fx-cursor: hand; -fx-font-size: 13px;"/>
                </HBox>

                <!-- Filters -->
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <ComboBox fx:id="cmbTipoFiltro" promptText="Todos los tipos" prefWidth="155"
                              onAction="#aplicarFiltros"
                              style="-fx-background-radius: 8;"/>
                    <TextField fx:id="txtMarcaFiltro" promptText="Filtrar marca" prefWidth="130"
                               onKeyReleased="#aplicarFiltros"
                               style="-fx-background-radius: 8; -fx-padding: 7; -fx-border-color: #E0E0E0; -fx-border-radius: 8;"/>
                    <Button text="Ver todos" onAction="#mostrarTodos"
                            style="-fx-background-color: #EEEEEE; -fx-background-radius: 6; -fx-padding: 7 10; -fx-font-size: 12px; -fx-cursor: hand;"/>
                </HBox>

                <!-- Results -->
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                            style="-fx-border-color: #F0F0F0; -fx-border-radius: 8; -fx-background-color: transparent;">
                    <VBox fx:id="vboxResultados" spacing="4" style="-fx-padding: 6;">
                        <Label text="Escribe para buscar o usa los botones de acceso rápido"
                               style="-fx-text-fill: #BBBBBB; -fx-font-style: italic; -fx-font-size: 12px;"/>
                    </VBox>
                </ScrollPane>

                <!-- Quick-access by type -->
                <HBox spacing="6" alignment="CENTER_LEFT" style="-fx-padding: 2 0 0 0;">
                    <Label text="Acceso rápido:"
                           style="-fx-font-size: 11px; -fx-text-fill: #999; -fx-font-weight: 600;"/>
                    <Button text="Maquillaje" onAction="#filtrarMaquillaje"
                            style="-fx-background-color: #FCE4EC; -fx-background-radius: 12; -fx-padding: 4 10;
                                   -fx-font-size: 11px; -fx-cursor: hand; -fx-border-color: #E91E63;
                                   -fx-border-radius: 12; -fx-border-width: 1;"/>
                    <Button text="Bolsos" onAction="#filtrarBolsos"
                            style="-fx-background-color: #FCE4EC; -fx-background-radius: 12; -fx-padding: 4 10;
                                   -fx-font-size: 11px; -fx-cursor: hand; -fx-border-color: #E91E63;
                                   -fx-border-radius: 12; -fx-border-width: 1;"/>
                    <Button text="Bisutería" onAction="#filtrarBisuteria"
                            style="-fx-background-color: #FCE4EC; -fx-background-radius: 12; -fx-padding: 4 10;
                                   -fx-font-size: 11px; -fx-cursor: hand; -fx-border-color: #E91E63;
                                   -fx-border-radius: 12; -fx-border-width: 1;"/>
                    <Button text="Cuidado Corporal" onAction="#filtrarCuidadoCorporal"
                            style="-fx-background-color: #FCE4EC; -fx-background-radius: 12; -fx-padding: 4 10;
                                   -fx-font-size: 11px; -fx-cursor: hand; -fx-border-color: #E91E63;
                                   -fx-border-radius: 12; -fx-border-width: 1;"/>
                    <Button text="Skincare" onAction="#filtrarSkincare"
                            style="-fx-background-color: #FCE4EC; -fx-background-radius: 12; -fx-padding: 4 10;
                                   -fx-font-size: 11px; -fx-cursor: hand; -fx-border-color: #E91E63;
                                   -fx-border-radius: 12; -fx-border-width: 1;"/>
                </HBox>
            </VBox>

            <!-- ===== RIGHT PANEL: Cart + Payment (40%) ===== -->
            <ScrollPane fitToWidth="true"
                        style="-fx-background-color: transparent; -fx-border-color: transparent;">
                <VBox spacing="10"
                      style="-fx-background-color: white; -fx-padding: 14;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 4, 0, 0, 1);">

                    <!-- Cart header -->
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="Carrito"
                               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #880E4F;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Vaciar" onAction="#limpiarCarrito"
                                style="-fx-background-color: transparent; -fx-text-fill: #D32F2F;
                                       -fx-font-size: 11px; -fx-cursor: hand; -fx-border-color: #D32F2F;
                                       -fx-border-radius: 4; -fx-padding: 3 8; -fx-border-width: 1;"/>
                    </HBox>

                    <!-- Cart list -->
                    <ListView fx:id="lstCarrito" prefHeight="170" VBox.vgrow="NEVER"
                              style="-fx-background-radius: 8; -fx-border-color: #EEEEEE; -fx-border-radius: 8;">
                        <placeholder>
                            <Label text="Carrito vacío — agrega productos"
                                   style="-fx-text-fill: #CCCCCC; -fx-font-style: italic;"/>
                        </placeholder>
                    </ListView>

                    <!-- Totals panel -->
                    <VBox spacing="5"
                          style="-fx-background-color: #FFF8F9; -fx-padding: 10; -fx-background-radius: 8;
                                 -fx-border-color: #FFCDD2; -fx-border-radius: 8; -fx-border-width: 1;">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Subtotal:" style="-fx-font-size: 13px; -fx-text-fill: #666;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="lblSubtotal" text=""
                                   style="-fx-font-size: 13px; -fx-text-fill: #444;"/>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="6">
                            <Label text="Descuento %:" style="-fx-font-size: 13px; -fx-text-fill: #666;"/>
                            <TextField fx:id="txtDescuento" text="0" prefWidth="55" maxWidth="60"
                                       onKeyReleased="#recalcularTotales"
                                       style="-fx-background-radius: 6; -fx-padding: 4; -fx-border-color: #E0E0E0;
                                              -fx-border-radius: 6; -fx-text-alignment: center; -fx-font-size: 13px;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="lblDescuentoMonto" text="-$0"
                                   style="-fx-font-size: 13px; -fx-text-fill: #4CAF50; -fx-font-weight: 600;"/>
                        </HBox>
                        <Separator style="-fx-opacity: 0.5;"/>
                        <HBox alignment="CENTER_LEFT">
                            <Label text="TOTAL:"
                                   style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #880E4F;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="lblTotal" text=""
                                   style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #880E4F;"/>
                        </HBox>
                    </VBox>

                    <!-- Customer selector -->
                    <VBox spacing="4">
                        <Label text="Cliente:"
                               style="-fx-font-weight: 600; -fx-text-fill: #4A148C; -fx-font-size: 12px;"/>
                        <HBox spacing="6" alignment="CENTER_LEFT">
                            <ComboBox fx:id="cmbCliente" promptText="Ocasional (sin registro)"
                                      HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                      style="-fx-background-radius: 8;"/>
                            <Button text="+" onAction="#agregarCliente"
                                    style="-fx-background-color: #E91E63; -fx-text-fill: white;
                                           -fx-font-weight: bold; -fx-font-size: 16px; -fx-background-radius: 6;
                                           -fx-padding: 5 11; -fx-cursor: hand;"/>
                        </HBox>
                    </VBox>

                    <!-- Payment method -->
                    <VBox spacing="6">
                        <Label text="Método de pago:"
                               style="-fx-font-weight: 600; -fx-text-fill: #4A148C; -fx-font-size: 12px;"/>
                        <GridPane hgap="8" vgap="5">
                            <RadioButton fx:id="rbEfectivo" text="Efectivo" selected="true"
                                         toggleGroup="$tgMetodoPago"
                                         GridPane.rowIndex="0" GridPane.columnIndex="0"
                                         style="-fx-font-size: 13px;"/>
                            <RadioButton fx:id="rbTarjeta" text="Tarjeta"
                                         toggleGroup="$tgMetodoPago"
                                         GridPane.rowIndex="0" GridPane.columnIndex="1"
                                         style="-fx-font-size: 13px;"/>
                            <RadioButton fx:id="rbTransferencia" text="Transferencia"
                                         toggleGroup="$tgMetodoPago"
                                         GridPane.rowIndex="1" GridPane.columnIndex="0"
                                         style="-fx-font-size: 13px;"/>
                            <RadioButton fx:id="rbNequi" text="Nequi"
                                         toggleGroup="$tgMetodoPago"
                                         GridPane.rowIndex="1" GridPane.columnIndex="1"
                                         style="-fx-font-size: 13px;"/>
                            <RadioButton fx:id="rbDaviplata" text="Daviplata"
                                         toggleGroup="$tgMetodoPago"
                                         GridPane.rowIndex="2" GridPane.columnIndex="0"
                                         style="-fx-font-size: 13px;"/>
                        </GridPane>
                    </VBox>

                    <!-- Notes -->
                    <TextField fx:id="txtNotas" promptText="Notas (opcional)"
                               style="-fx-background-radius: 8; -fx-padding: 8; -fx-border-color: #E0E0E0;
                                      -fx-border-radius: 8; -fx-font-size: 12px;"/>

                    <!-- Virtual sale -->
                    <CheckBox fx:id="chkVentaVirtual" text="Venta virtual"
                              style="-fx-font-size: 13px; -fx-text-fill: #4A148C;"/>

                    <!-- Error label -->
                    <Label fx:id="lblError" text="" wrapText="true" maxWidth="Infinity"
                           style="-fx-text-fill: #D32F2F; -fx-font-size: 12px;
                                  -fx-background-color: #FFEBEE; -fx-background-radius: 6; -fx-padding: 6;"/>

                    <!-- COBRAR — the most prominent button in the app -->
                    <Button fx:id="btnCobrar" text="COBRAR  $0"
                            onAction="#cobrar" maxWidth="Infinity"
                            style="-fx-background-color: #880E4F; -fx-text-fill: white;
                                   -fx-font-size: 20px; -fx-font-weight: 900;
                                   -fx-background-radius: 10; -fx-padding: 18;
                                   -fx-cursor: hand;
                                   -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 12, 0, 0, 5);"/>

                </VBox>
            </ScrollPane>
        </SplitPane>
    </center>

</BorderPane>
