<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.marcofidel_dev.inventario.ui.controller.CobroModalController"
      spacing="16" minWidth="340"
      style="-fx-background-color: white; -fx-padding: 28; -fx-background-radius: 12;
             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, 3);">

    <Label text="Confirmar Venta"
           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #880E4F;"/>

    <Separator/>

    <!-- Sale summary -->
    <GridPane hgap="20" vgap="8">
        <columnConstraints>
            <ColumnConstraints minWidth="140"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>
        <Label text="Total a cobrar:" GridPane.rowIndex="0" GridPane.columnIndex="0"
               style="-fx-font-weight: 600; -fx-text-fill: #4A148C;"/>
        <Label fx:id="lblTotal" text="" GridPane.rowIndex="0" GridPane.columnIndex="1"
               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #880E4F;"/>
        <Label text="Método:" GridPane.rowIndex="1" GridPane.columnIndex="0"
               style="-fx-font-weight: 600; -fx-text-fill: #4A148C;"/>
        <Label fx:id="lblMetodo" text="" GridPane.rowIndex="1" GridPane.columnIndex="1"
               style="-fx-font-size: 14px; -fx-text-fill: #555;"/>
    </GridPane>

    <!-- Efectivo section (only shown for EFECTIVO payment) -->
    <VBox fx:id="pnlEfectivo" spacing="10"
          style="-fx-background-color: #FFF8F9; -fx-padding: 14; -fx-background-radius: 8;
                 -fx-border-color: #FFCDD2; -fx-border-radius: 8; -fx-border-width: 1;">

        <VBox spacing="6">
            <Label text="Efectivo recibido ($):"
                   style="-fx-font-weight: 600; -fx-text-fill: #4A148C; -fx-font-size: 13px;"/>
            <TextField fx:id="txtEfectivoRecibido" promptText="0"
                       style="-fx-background-radius: 8; -fx-padding: 10; -fx-border-color: #E0E0E0;
                              -fx-border-radius: 8; -fx-font-size: 18px; -fx-text-alignment: right;"/>
        </VBox>

        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label text="Cambio:" style="-fx-font-weight: 600; -fx-text-fill: #4A148C; -fx-font-size: 14px;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblCambio" text=""
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #4CAF50;"/>
        </HBox>
    </VBox>

    <Label fx:id="lblError" text="" wrapText="true"
           style="-fx-text-fill: #D32F2F; -fx-font-size: 12px;"/>

    <HBox spacing="12" alignment="CENTER_RIGHT">
        <Button text="Cancelar" onAction="#cancelar"
                style="-fx-background-color: #EEEEEE; -fx-text-fill: #555; -fx-background-radius: 8;
                       -fx-padding: 10 20; -fx-font-weight: 600; -fx-cursor: hand;"/>
        <Button fx:id="btnConfirmar" text="Confirmar y Cobrar" onAction="#confirmar"
                style="-fx-background-color: #880E4F; -fx-text-fill: white; -fx-background-radius: 8;
                       -fx-padding: 10 20; -fx-font-weight: 700; -fx-font-size: 14px; -fx-cursor: hand;
                       -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 6, 0, 0, 2);"/>
    </HBox>
</VBox>
