<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.marcofidel_dev.inventario.ui.controller.ReporteClientesController"
      spacing="14" style="-fx-padding: 20; -fx-background-color: #FCE4EC;">

    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label text="Análisis de Clientes"
               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #880E4F;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Período:" style="-fx-font-weight: 600;"/>
        <DatePicker fx:id="dpDesde" prefWidth="130"/>
        <Label text="al" style="-fx-font-weight: 600;"/>
        <DatePicker fx:id="dpHasta" prefWidth="130"/>
        <Button text="Aplicar" onAction="#aplicar"
                style="-fx-background-color: #880E4F; -fx-text-fill: white; -fx-background-radius: 8;
                       -fx-padding: 8 16; -fx-font-weight: 600; -fx-cursor: hand;"/>
        <Button text="📊 Excel" onAction="#exportarExcel"
                style="-fx-background-color: #388E3C; -fx-text-fill: white; -fx-background-radius: 8;
                       -fx-padding: 8 14; -fx-font-weight: 600; -fx-cursor: hand;"/>
    </HBox>

    <!-- Métricas generales -->
    <HBox spacing="24" alignment="CENTER_LEFT"
          style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 16;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 6, 0, 0, 2);">
        <Label text="Métricas" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #880E4F;"/>
        <Separator orientation="VERTICAL"/>
        <VBox spacing="3" alignment="CENTER">
            <Label text="Total clientes" style="-fx-font-size: 11px; -fx-text-fill: #757575;"/>
            <Label fx:id="lblTotalClientes" text="" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        </VBox>
        <VBox spacing="3" alignment="CENTER">
            <Label text="Activos (período)" style="-fx-font-size: 11px; -fx-text-fill: #757575;"/>
            <Label fx:id="lblClientesActivos" text="" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #4CAF50;"/>
        </VBox>
        <VBox spacing="3" alignment="CENTER">
            <Label text="Inactivos 90d+" style="-fx-font-size: 11px; -fx-text-fill: #757575;"/>
            <Label fx:id="lblClientesInactivos" text="" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #F57C00;"/>
        </VBox>
    </HBox>

    <!-- Top clientes -->
    <VBox spacing="8" VBox.vgrow="ALWAYS"
          style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 16;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 6, 0, 0, 2);">
        <Label text="🏆 Top 10 Clientes (período)"
               style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #880E4F;"/>
        <TableView fx:id="tblTopClientes" VBox.vgrow="ALWAYS" prefHeight="230">
            <columns>
                <TableColumn fx:id="colTCNombre"   text="Cliente"       prefWidth="200"/>
                <TableColumn fx:id="colTCPhone"    text="Teléfono"      prefWidth="120"/>
                <TableColumn fx:id="colTCCompras"  text="Compras"       prefWidth="80"/>
                <TableColumn fx:id="colTCTotal"    text="Total"         prefWidth="120"/>
                <TableColumn fx:id="colTCUltima"   text="Última compra" prefWidth="150"/>
            </columns>
        </TableView>
    </VBox>

    <!-- Clientes inactivos -->
    <VBox spacing="8"
          style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 16;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 6, 0, 0, 2);">
        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label text="💤 Clientes Inactivos"
                   style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #880E4F;"/>
            <Label text="Sin comprar desde hace:" style="-fx-font-size: 12px;"/>
            <Spinner fx:id="spinerDias" editable="true" prefWidth="80"/>
            <Label text="días" style="-fx-font-size: 12px;"/>
            <Button text="Buscar" onAction="#buscarInactivos"
                    style="-fx-background-color: #E91E63; -fx-text-fill: white;
                           -fx-background-radius: 8; -fx-padding: 6 12; -fx-font-weight: 600; -fx-cursor: hand;"/>
        </HBox>
        <TableView fx:id="tblClientesInactivos" prefHeight="180">
            <columns>
                <TableColumn fx:id="colCINombre"   text="Cliente"          prefWidth="200"/>
                <TableColumn fx:id="colCIPhone"    text="Teléfono"         prefWidth="120"/>
                <TableColumn fx:id="colCIUltima"   text="Última compra"    prefWidth="130"/>
                <TableColumn fx:id="colCIDias"     text="Días inactivo"    prefWidth="110"/>
                <TableColumn fx:id="colCIHistorico" text="Total histórico" prefWidth="130"/>
            </columns>
        </TableView>
    </VBox>

</VBox>
