<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.marcofidel_dev.inventario.ui.controller.ProductosController"
            style="-fx-background-color: #FCE4EC;">

    <top>
        <VBox spacing="15" style="-fx-padding: 20; -fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);">
            <Label text="Gestión de Productos" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #880E4F;"/>

            <!-- Filtros -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="txtBuscar" promptText="Buscar por nombre o Codigo..." prefWidth="250"
                           style="-fx-background-radius: 8; -fx-padding: 8; -fx-border-color: #E0E0E0; -fx-border-radius: 8;"/>
                <ComboBox fx:id="cmbFiltroTipo" promptText="Filtrar por tipo" prefWidth="150"
                          style="-fx-background-radius: 8; -fx-padding: 8;"/>
                <CheckBox fx:id="chkStockBajo" text="Solo stock bajo"
                          style="-fx-text-fill: #880E4F; -fx-font-weight: 600;"/>
                <Button text="🔍 Buscar" onAction="#cargarProductos"
                        style="-fx-background-color: #E91E63; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 16; -fx-font-weight: 600; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 5, 0, 0, 2);"/>
                <Button text="➕ Nuevo" onAction="#nuevo"
                        style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 8 16; -fx-font-weight: 600; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 5, 0, 0, 2);"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.6">
            <BorderPane.margin>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </BorderPane.margin>
            <!-- Lista de productos -->
            <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);">
                <Label text="Lista de Productos" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #880E4F;"/>
                <TableView fx:id="tblProductos" VBox.vgrow="ALWAYS" style="-fx-background-radius: 8;">
                    <columns>
                        <TableColumn fx:id="colNombre" text="Nombre" prefWidth="150"/>
                        <TableColumn fx:id="colTipo" text="Tipo" prefWidth="100"/>
                        <TableColumn fx:id="colMarca" text="Marca" prefWidth="100"/>
                        <TableColumn fx:id="colSku" text="C.producto" prefWidth="100"/>
                        <TableColumn fx:id="colCosto" text="Costo" prefWidth="80"/>
                        <TableColumn fx:id="colPrecio" text="Precio" prefWidth="80"/>
                        <TableColumn fx:id="colStock" text="Stock" prefWidth="60"/>
                        <TableColumn fx:id="colStockMin" text="Mín" prefWidth="60"/>
                    </columns>
                </TableView>
            </VBox>

            <!-- Formulario -->
            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
                <VBox spacing="15" style="-fx-padding: 15; -fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);">
                    <Label text="Datos del Producto" style="-fx-font-weight: bold; -fx-font-size: 18px; -fx-text-fill: #880E4F;"/>

                    <GridPane hgap="10" vgap="12">
                        <columnConstraints>
                            <ColumnConstraints minWidth="100" prefWidth="120"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="*Tipo:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: 600; -fx-text-fill: #4A148C;"/>
                        <ComboBox fx:id="cmbTipo" GridPane.rowIndex="0" GridPane.columnIndex="1" maxWidth="Infinity" style="-fx-background-radius: 8;"/>

                        <Label text="*Nombre:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: 600; -fx-text-fill: #4A148C;"/>
                        <TextField fx:id="txtNombre" GridPane.rowIndex="1" GridPane.columnIndex="1" style="-fx-background-radius: 8; -fx-padding: 8;"/>

                        <Label text="Marca/Provedor:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: 600; -fx-text-fill: #4A148C;"/>
                        <TextField fx:id="txtMarca" GridPane.rowIndex="2" GridPane.columnIndex="1" style="-fx-background-radius: 8; -fx-padding: 8;"/>

                        <Label text="C.Producto:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-weight: 600; -fx-text-fill: #4A148C;"/>
                        <TextField fx:id="txtSku" GridPane.rowIndex="3" GridPane.columnIndex="1" style="-fx-background-radius: 8; -fx-padding: 8;"/>

                        <Label text="*Costo:" GridPane.rowIndex="4" GridPane.columnIndex="0" style="-fx-font-weight: 600; -fx-text-fill: #4A148C;"/>
                        <TextField fx:id="txtCosto" GridPane.rowIndex="4" GridPane.columnIndex="1" style="-fx-background-radius: 8; -fx-padding: 8;"/>

                        <Label text="*Precio Venta:" GridPane.rowIndex="5" GridPane.columnIndex="0" style="-fx-font-weight: 600; -fx-text-fill: #4A148C;"/>
                        <TextField fx:id="txtPrecioVenta" GridPane.rowIndex="5" GridPane.columnIndex="1" style="-fx-background-radius: 8; -fx-padding: 8;"/>

                        <Label text="*Stock Actual:" GridPane.rowIndex="6" GridPane.columnIndex="0" style="-fx-font-weight: 600; -fx-text-fill: #4A148C;"/>
                        <TextField fx:id="txtStockActual" GridPane.rowIndex="6" GridPane.columnIndex="1" style="-fx-background-radius: 8; -fx-padding: 8;"/>

                        <Label text="*Stock Mínimo:" GridPane.rowIndex="7" GridPane.columnIndex="0" style="-fx-font-weight: 600; -fx-text-fill: #4A148C;"/>
                        <TextField fx:id="txtStockMinimo" GridPane.rowIndex="7" GridPane.columnIndex="1" style="-fx-background-radius: 8; -fx-padding: 8;"/>

                        <Separator GridPane.rowIndex="8" GridPane.columnSpan="2" style="-fx-background-color: #E91E63;"/>

                        <Label text="N°Tono/Color:" GridPane.rowIndex="9" GridPane.columnIndex="0" style="-fx-font-weight: 600; -fx-text-fill: #4A148C;"/>
                        <TextField fx:id="txtTonoColor" GridPane.rowIndex="9" GridPane.columnIndex="1" style="-fx-background-radius: 8; -fx-padding: 8;"/>

                        <CheckBox fx:id="chkActivo" text="Activo" selected="true" GridPane.rowIndex="10" GridPane.columnSpan="2"
                                  style="-fx-text-fill: #880E4F; -fx-font-weight: 600;"/>
                    </GridPane>

                    <HBox spacing="10" alignment="CENTER">
                        <Button text="💾 Guardar" onAction="#guardar"
                                style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 20; -fx-font-weight: 600; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 5, 0, 0, 2);"/>
                        <Button text="🗑️ Eliminar" onAction="#eliminar"
                                style="-fx-background-color: #F44336; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 20; -fx-font-weight: 600; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 5, 0, 0, 2);"/>
                        <Button text="🔄 Limpiar" onAction="#nuevo"
                                style="-fx-background-color: #FF9800; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 20; -fx-font-weight: 600; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 5, 0, 0, 2);"/>
                    </HBox>
                </VBox>
            </ScrollPane>
        </SplitPane>
    </center>

</BorderPane>

