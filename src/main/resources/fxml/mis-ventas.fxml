<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.marcofidel_dev.inventario.ui.controller.MisVentasController"
            style="-fx-background-color: #FCE4EC;">

    <top>
        <VBox spacing="14"
              style="-fx-background-color: white; -fx-padding: 20;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);">

            <!-- Title + date -->
            <HBox alignment="CENTER_LEFT" spacing="16">
                <Label text="Mis Ventas de Hoy"
                       style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #880E4F;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblFechaHoy" text=""
                       style="-fx-text-fill: #888; -fx-font-size: 13px;"/>
                <Button text="↻ Actualizar" onAction="#cargar"
                        style="-fx-background-color: #E91E63; -fx-text-fill: white; -fx-background-radius: 8;
                               -fx-padding: 7 14; -fx-font-weight: 600; -fx-cursor: hand;"/>
            </HBox>

            <!-- Summary cards -->
            <HBox spacing="12">
                <!-- Total cobrado -->
                <VBox alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: #FCE4EC; -fx-padding: 14; -fx-background-radius: 10;
                             -fx-border-color: #F48FB1; -fx-border-radius: 10;">
                    <Label text="Total cobrado"
                           style="-fx-font-size: 11px; -fx-text-fill: #888; -fx-font-weight: 600;"/>
                    <Label fx:id="lblTotalCobrado" text=""
                           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #880E4F;"/>
                </VBox>
                <!-- Ventas count -->
                <VBox alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: #F3E5F5; -fx-padding: 14; -fx-background-radius: 10;
                             -fx-border-color: #CE93D8; -fx-border-radius: 10;">
                    <Label text="Ventas"
                           style="-fx-font-size: 11px; -fx-text-fill: #888; -fx-font-weight: 600;"/>
                    <Label fx:id="lblCantidadVentas" text="0"
                           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #6A1B9A;"/>
                </VBox>
                <!-- Efectivo -->
                <VBox alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: #E8F5E9; -fx-padding: 14; -fx-background-radius: 10;
                             -fx-border-color: #A5D6A7; -fx-border-radius: 10;">
                    <Label text="Efectivo"
                           style="-fx-font-size: 11px; -fx-text-fill: #888; -fx-font-weight: 600;"/>
                    <Label fx:id="lblTotalEfectivo" text=""
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2E7D32;"/>
                </VBox>
                <!-- Otros métodos -->
                <VBox alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: #E3F2FD; -fx-padding: 14; -fx-background-radius: 10;
                             -fx-border-color: #90CAF9; -fx-border-radius: 10;">
                    <Label text="Digital / Tarjeta"
                           style="-fx-font-size: 11px; -fx-text-fill: #888; -fx-font-weight: 600;"/>
                    <Label fx:id="lblTotalDigital" text=""
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1565C0;"/>
                </VBox>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="10" style="-fx-padding: 14;">
            <VBox style="-fx-background-color: white; -fx-background-radius: 10;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 5, 0, 0, 2);" VBox.vgrow="ALWAYS">
                <VBox.margin>
                    <Insets/>
                </VBox.margin>

                <TableView fx:id="tblVentas" VBox.vgrow="ALWAYS"
                           style="-fx-background-radius: 10; -fx-background-color: transparent;">
                    <columns>
                        <TableColumn fx:id="colHora"    text="Hora"    prefWidth="75"/>
                        <TableColumn fx:id="colCliente" text="Cliente" prefWidth="160"/>
                        <TableColumn fx:id="colItems"   text="Items"   prefWidth="60"/>
                        <TableColumn fx:id="colTotal"   text="Total"   prefWidth="110"/>
                        <TableColumn fx:id="colMetodo"  text="Método"  prefWidth="110"/>
                        <TableColumn fx:id="colEstado"  text="Estado"  prefWidth="90"/>
                    </columns>
                    <placeholder>
                        <Label text="No hay ventas registradas en esta sesión."
                               style="-fx-text-fill: #AAAAAA; -fx-font-style: italic;"/>
                    </placeholder>
                </TableView>
            </VBox>

            <Label text="Doble clic en una venta para ver el detalle"
                   style="-fx-text-fill: #AAAAAA; -fx-font-size: 11px; -fx-font-style: italic;"/>
        </VBox>
    </center>

</BorderPane>
